ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Socket.IO-Client-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/Starscream" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoPluginAdapter" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoPrebuiltLog" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKitPrebuiltCall" "${PODS_ROOT}/ZegoExpressEngine/release/Library" "${PODS_ROOT}/ZegoUIKitReport/release" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ZegoExpressEngine" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ZegoUIKitReport"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Socket.IO-Client-Swift/SocketIO.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Starscream/Starscream.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation/ZIPFoundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoPluginAdapter/ZegoPluginAdapter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoPrebuiltLog/ZegoPrebuiltLog.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKit/ZegoUIKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKitPrebuiltCall/ZegoUIKitPrebuiltCall.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -framework "SocketIO" -framework "Starscream" -framework "ZIPFoundation" -framework "ZegoConnection" -framework "ZegoExpressEngine" -framework "ZegoPluginAdapter" -framework "ZegoPrebuiltLog" -framework "ZegoUIKit" -framework "ZegoUIKitPrebuiltCall" -framework "ZegoUIKitReport"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Socket.IO-Client-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/Starscream" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoExpressEngine" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoPluginAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoPrebuiltLog" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKitPrebuiltCall" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZegoUIKitReport"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
